# ───────── Core ─────────
DATABASE_URL=postgres://shaqlah:shaqlah@localhost:5432/shaqlah
# DATABASE_SSL=true            # managed Postgres (Supabase, Neon, RDS…)
APP_URL=http://localhost:3000   # public https URL in production (used for payment return links)
AUTH_SECRET=                    # 32+ random chars: `openssl rand -base64 48`

# ───────── First admin (used by `npm run db:seed`) ─────────
ADMIN_NAME=مدير شقلح
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=                 # required in production
# SEED_SAMPLE_MENU=true         # defaults to true in dev, false in production

# ───────── Uploads (menu images, logo) ─────────
# UPLOAD_DIR=./uploads          # mount a persistent volume here in production

# ───────── Online payments — Thawani Pay (requires a merchant account) ─────────
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_ENV=uat                 # uat | live
# THAWANI_BASE_URL=             # optional override

# ───────── Email (optional) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="شقلح <no-reply@example.com>"

# ───────── SMS via Twilio (optional) ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ───────── WhatsApp Business Cloud API (optional, needs an approved template) ─────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
